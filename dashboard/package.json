{
  "name": "@mg/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:css",
    "build:css": "tailwindcss -i src/styles/tokens.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@hono/node-server": "2.1.1",
    "@mg/core": "workspace:*",
    "@mg/gate": "workspace:*",
    "@mg/harness": "workspace:*",
    "@mg/runner": "workspace:*",
    "@mg/tools": "workspace:*",
    "hono": "4.13.7",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "25.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6"
  }
}
