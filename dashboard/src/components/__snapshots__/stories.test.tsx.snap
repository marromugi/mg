exports[`story snapshots > ./feature/HarnessEditor/HarnessEditor.stories.tsx Editing 1`] = `"<form class="flex flex-col gap-6" action="/harnesses/0b1c2d3e" method="post"><button type="submit" value="save" hidden="" tabindex="-1" name="intent"></button><div class="flex flex-col gap-1"><label for="name" class="font-semibold">名前</label><input id="name" type="text" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring" name="name" value="files"/></div><fieldset class="flex flex-col gap-3 rounded-container border border-edge container-p-4"><legend class="px-2 font-semibold">LLM</legend><div class="flex flex-col gap-1"><label for="provider" class="font-semibold">プロバイダー</label><select id="provider" name="provider" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring"><option value="openrouter" selected="">OpenRouter</option><option value="ollama">Ollama</option></select></div><div class="flex flex-col gap-1"><label for="baseUrl" class="font-semibold">Ollama のアドレス</label><p id="baseUrl-hint" class="text-meta">Ollama のときだけ使います。省略できます。</p><input id="baseUrl" type="text" aria-describedby="baseUrl-hint" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring" name="baseUrl" value=""/></div><div class="flex flex-col gap-1"><label for="model" class="font-semibold">モデル</label><input id="model" type="text" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring" name="model" value="deepseek/deepseek-v4-flash"/></div><div class="flex flex-col gap-1"><label for="maxTurns" class="font-semibold">ターン数の上限</label><input id="maxTurns" type="number" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring" name="maxTurns" value="10"/></div></fieldset><fieldset class="flex flex-col gap-3 rounded-container border border-edge container-p-4"><legend class="px-2 font-semibold">ツール</legend><p class="text-meta">ツールを選ぶと、作業フォルダと、パスのルールか判定 LLM が要ります。何も選ばなければ、これより下の設定は保存されません。</p><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="tools" value="bash"/>bash</label><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="tools" checked="" value="read_file"/>read_file</label><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="tools" checked="" value="grep"/>grep</label><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="tools" value="write_file"/>write_file</label><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="tools" value="edit_file"/>edit_file</label></fieldset><div class="flex flex-col gap-1"><label for="root" class="font-semibold">作業フォルダ</label><p id="root-hint" class="text-meta">絶対パスで書きます。</p><input id="root" type="text" aria-describedby="root-hint" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring" name="root" value="/Users/me/work"/></div><fieldset class="flex flex-col gap-3 rounded-container border border-edge container-p-4"><legend class="px-2 font-semibold">パスのルール</legend><fieldset class="flex flex-col gap-3 rounded-container border border-edge container-p-4"><legend class="px-2 font-semibold">ルール 1</legend><fieldset class="flex flex-col gap-3 rounded-container border border-edge container-p-4"><legend class="px-2 font-semibold">対象のツール</legend><p class="text-meta">何も選ばなければ、すべてのツールが対象です。</p><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="rules.0.tools" value="bash"/>bash</label><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="rules.0.tools" value="read_file"/>read_file</label><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="rules.0.tools" value="grep"/>grep</label><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="rules.0.tools" value="write_file"/>write_file</label><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="rules.0.tools" value="edit_file"/>edit_file</label></fieldset><div class="flex flex-col gap-1"><label for="rules.0.paths" class="font-semibold">パスのパターン</label><p id="rules.0.paths-hint" class="text-meta">1 行に 1 つ書きます。空なら、すべてのパスが対象です。</p><textarea id="rules.0.paths" name="rules.0.paths" rows="3" aria-describedby="rules.0.paths-hint" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring">.env</textarea></div><div class="flex flex-col gap-1"><label for="rules.0.effect" class="font-semibold">扱い</label><select id="rules.0.effect" name="rules.0.effect" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring"><option value="deny" selected="">拒否する</option><option value="allow">許可する</option></select></div><div class="flex flex-col gap-1"><label for="rules.0.reason" class="font-semibold">理由</label><input id="rules.0.reason" type="text" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring" name="rules.0.reason" value="Secrets stay private."/></div><div><button type="submit" value="remove-rule:0" class="inline-flex cursor-pointer items-center rounded-control font-semibold transition duration-160 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-97 gap-2 px-4 control-py-2 text-sm border border-edge hover:bg-edge" name="intent">このルールを消す</button></div></fieldset><div><button type="submit" value="add-rule" class="inline-flex cursor-pointer items-center rounded-control font-semibold transition duration-160 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-97 gap-2 px-4 control-py-2 text-sm border border-edge hover:bg-edge" name="intent">ルールを追加</button></div></fieldset><fieldset class="flex flex-col gap-3 rounded-container border border-edge container-p-4"><legend class="px-2 font-semibold">判定 LLM</legend><p class="text-meta">ハーネスと同じプロバイダーを使います。</p><label class="flex items-center gap-2"><input type="checkbox" class="accent-accent" name="judge" value="on"/>判定 LLM を使う</label><div class="flex flex-col gap-1"><label for="judgeModel" class="font-semibold">判定 LLM のモデル</label><input id="judgeModel" type="text" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring" name="judgeModel" value=""/></div><div class="flex flex-col gap-1"><label for="judgeInstruction" class="font-semibold">判定 LLM への指示</label><textarea id="judgeInstruction" name="judgeInstruction" rows="3" class="w-full rounded-control border px-3 control-py-2 transition duration-160 ease-out outline-none border-edge focus-visible:shadow-ring"></textarea></div></fieldset><div class="flex gap-3"><button type="submit" value="save" class="inline-flex cursor-pointer items-center rounded-control font-semibold transition duration-160 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-97 gap-2 px-4 control-py-2 text-sm border border-on-accent/30 bg-accent text-on-accent hover:brightness-110" name="intent">保存</button><a href="/harnesses" class="inline-flex cursor-pointer items-center rounded-control font-semibold transition duration-160 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-97 gap-2 px-4 control-